# ════════════════════════════════════════════════════════════════════════════
#  Chatwoot Custom — Environment Template
#  Copy this to .env and fill in YOUR OWN values
#  DO NOT COMMIT .env — it is gitignored for security
# ════════════════════════════════════════════════════════════════════════════

# ── ElevenLabs Voice Agent (build-time) ────────────────────────────────────
# Get your agent ID from: https://elevenlabs.io/
VITE_ELEVENLABS_AGENT_ID=REPLACE_WITH_YOUR_AGENT_ID
VITE_ELEVENLABS_VOICE_ID=REPLACE_WITH_YOUR_VOICE_ID
VITE_ELEVENLABS_AGENT_NAME=AI Assistant

# ── Public URL ─────────────────────────────────────────────────────────────
# Your production domain or ngrok URL
FRONTEND_URL=https://your-domain.com

# ── Rails secret (generate new one for production) ──────────────────────────
# Generate with: docker run -it rails:7 rails secret
SECRET_KEY_BASE=GENERATE_NEW_WITH_RAILS_SECRET_COMMAND

# ── Rails runtime ──────────────────────────────────────────────────────────
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
INSTALLATION_ENV=docker
FORCE_SSL=false

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_prod
POSTGRES_USERNAME=chatwoot_prod
POSTGRES_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD
REDIS_URL=redis://:YOUR_SECURE_REDIS_PASSWORD@redis:6379

# ── Mailer (configure for outgoing emails) ──────────────────────────────────
# Leave blank to disable email sending
MAILER_SENDER_EMAIL=your-email@yourdomain.com
SMTP_DOMAIN=yourdomain.com
SMTP_ADDRESS=your.smtp.server.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# ── File storage ───────────────────────────────────────────────────────────
ACTIVE_STORAGE_SERVICE=local

# ── Security toggles ───────────────────────────────────────────────────────
ENABLE_RACK_ATTACK_WIDGET_API=false
WEB_WIDGET_ALLOWED_ORIGINS=

# ── Optional integrations ──────────────────────────────────────────────────
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
