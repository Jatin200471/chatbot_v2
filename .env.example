# ── Public URL ─────────────────────────────────────────────────────────────
# Your AWS domain — ALB DNS or custom domain (with https)
# Example: https://chat.yourcompany.com  OR  https://your-alb.us-east-1.elb.amazonaws.com
FRONTEND_URL=https://your-domain.com

# ── WebSocket Cable URL ─────────────────────────────────────────────────────
# Must match FRONTEND_URL but with wss:// scheme
# Example: wss://chat.yourcompany.com/cable
CABLE_URL=wss://your-domain.com/cable

# ── Rails secret ───────────────────────────────────────────────────────────
# REQUIRED on ECS — containers are stateless, auto-generate does not persist.
# Generate with: openssl rand -hex 64
# Store in AWS Secrets Manager and inject here.
SECRET_KEY_BASE=your-64-char-secret-key-here

# ── Rails runtime ──────────────────────────────────────────────────────────
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
INSTALLATION_ENV=docker
# ALB handles SSL termination — keep false unless ECS handles SSL directly
FORCE_SSL=false

# ── Postgres (AWS RDS) ─────────────────────────────────────────────────────
# Use your RDS endpoint — NOT "postgres" (that is only for local Docker)
# Example: your-db-instance.xxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_HOST=your-rds-endpoint.xxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=prod_chatwoot
POSTGRES_USERNAME=prod_admin
POSTGRES_USER=prod_admin
# Store in AWS Secrets Manager
POSTGRES_PASSWORD=your-rds-password

# ── Redis (AWS ElastiCache) ─────────────────────────────────────────────────
# Use your ElastiCache endpoint — NOT "redis" (that is only for local Docker)
# Example: your-cache.xxxxxx.cache.amazonaws.com
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@your-cache.xxxxxx.cache.amazonaws.com:6379

# ── Mailer ─────────────────────────────────────────────────────────────────
MAILER_SENDER_EMAIL=your-email@yourdomain.com
SMTP_DOMAIN=yourdomain.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
# Store in AWS Secrets Manager
SMTP_PASSWORD=your-smtp-app-password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# ── File Storage (AWS S3) ───────────────────────────────────────────────────
# ECS containers are stateless — local storage is lost on restart.
# Use S3 for persistent file/attachment storage.
ACTIVE_STORAGE_SERVICE=amazon
S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ── Security toggles ───────────────────────────────────────────────────────
ENABLE_RACK_ATTACK_WIDGET_API=false
WEB_WIDGET_ALLOWED_ORIGINS=

# ── Account Signup ─────────────────────────────────────────────────────────
ENABLE_ACCOUNT_SIGNUP=true

# ── Email Confirmation ─────────────────────────────────────────────────────
ENABLE_EMAIL_CONFIRMATION=false


