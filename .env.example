# ════════════════════════════════════════════════════════════════════════════
#  Chatwoot Custom — Local / Development Environment
#  THIS FILE IS GITIGNORED. Real secrets go here. Do not share or commit.
# ════════════════════════════════════════════════════════════════════════════

# ── Voice Agent ────────────────────────────────────────────────────────────
# Voice agent provider + agent_id + API key are now configured **per inbox**
# from the Chatwoot dashboard (Inbox → Configuration → Voice Agent).
# Nothing voice-related needs to live in this file anymore.

# ── Public URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=

# ── Rails secret ───────────────────────────────────────────────────────────
# SECRET_KEY_BASE is auto-generated on first boot and saved to the storage
# volume (/app/storage/.secret_key_base). No need to set it here.
# SECRET_KEY_BASE=

# ── Rails runtime ──────────────────────────────────────────────────────────
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
INSTALLATION_ENV=docker
FORCE_SSL=false

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=prod_chatwoot
POSTGRES_USERNAME=prod_admin
POSTGRES_USER=prod_admin
POSTGRES_PASSWORD=BYOYYMqbF6ojjMsP9y8LG

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=password
REDIS_URL=redis://:password@redis:6379

# ── Mailer (configure for outgoing emails — currently disabled) ────────────
MAILER_SENDER_EMAIL=
SMTP_DOMAIN=
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=
SMTP_OPENSSL_VERIFY_MODE=

# ── File storage ───────────────────────────────────────────────────────────
ACTIVE_STORAGE_SERVICE=local

# ── Security toggles ───────────────────────────────────────────────────────
ENABLE_RACK_ATTACK_WIDGET_API=false
WEB_WIDGET_ALLOWED_ORIGINS=

# ── Account Signup ─────────────────────────────────────────────────────────
ENABLE_ACCOUNT_SIGNUP=true 

# ── Email Confirmation ─────────────────────────────────────────────────────
# Skip email verification for new users (testing/local use)
ENABLE_EMAIL_CONFIRMATION=false

# ── Optional integrations ──────────────────────────────────────────────────
# N8N_WEBHOOK_URL=
# SENTRY_DSN=

CABLE_URL=
