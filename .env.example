# ════════════════════════════════════════════════════════════════════════════
#  Chatwoot Custom — Environment Template
#
#  SETUP STEPS:
#  1. Copy this file:  cp .env.example .env
#  2. Fill in values below (especially SECRET_KEY_BASE)
#  3. Run: docker compose up -d
#
#  DO NOT COMMIT .env — it is gitignored for security
# ════════════════════════════════════════════════════════════════════════════

# ── App URL ────────────────────────────────────────────────────────────────
# Local testing:      http://localhost:3000
# With ngrok:         https://your-ngrok-url.ngrok-free.app
# Production domain:  https://your-domain.com
FRONTEND_URL=http://localhost:3000

# ── Port (optional) ────────────────────────────────────────────────────────
# Default is 3000. Change if port is already in use.
PORT=3000

# ── Rails Secret Key ───────────────────────────────────────────────────────
# IMPORTANT: Generate a new one with this command:
# docker run --rm ruby:3 ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
SECRET_KEY_BASE=REPLACE_WITH_GENERATED_SECRET

# ── Rails Runtime ──────────────────────────────────────────────────────────
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
INSTALLATION_ENV=docker
FORCE_SSL=false

# ── Database (Postgres) ────────────────────────────────────────────────────
# Do NOT change POSTGRES_HOST — must match the service name in docker-compose
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_prod
POSTGRES_USERNAME=chatwoot_prod
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ── Cache (Redis) ──────────────────────────────────────────────────────────
# Use the SAME password in both REDIS_PASSWORD and REDIS_URL below
REDIS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_SECURE_PASSWORD@redis:6379

# ── Email / SMTP (optional) ────────────────────────────────────────────────
# Leave blank to disable outgoing emails
MAILER_SENDER_EMAIL=
SMTP_DOMAIN=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# ── File Storage ───────────────────────────────────────────────────────────
ACTIVE_STORAGE_SERVICE=local

# ── Security ───────────────────────────────────────────────────────────────
ENABLE_RACK_ATTACK_WIDGET_API=false
WEB_WIDGET_ALLOWED_ORIGINS=

# ── Account Signup ─────────────────────────────────────────────────────────
# true  = Anyone can create account (for testing)
# false = Signup disabled (for production)
ENABLE_ACCOUNT_SIGNUP=false

# ── Email Confirmation ─────────────────────────────────────────────────────
# false = No email verification needed (good for testing)
# true  = Users must verify email before login
ENABLE_EMAIL_CONFIRMATION=false

# ── Optional Integrations ──────────────────────────────────────────────────
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
