# ── Public URL ─────────────────────────────────────────────────────────────
# Your AWS domain — ALB DNS or custom domain (with https)
# Example: https://chat.yourcompany.com  OR  https://your-alb.us-east-1.elb.amazonaws.com
FRONTEND_URL=



# ── Rails secret ───────────────────────────────────────────────────────────
# REQUIRED on ECS — containers are stateless, auto-generate does not persist.
#
# HOW TO SET ON AWS ECS (do NOT put real value here):
#   1. Generate:  openssl rand -hex 64
#   2. Store in:  AWS Secrets Manager → Name: chatwoot/prod/secret_key_base
#   3. In ECS Task Definition → Container → Environment variables:
#        Key:   SECRET_KEY_BASE
#        Type:  ValueFrom
#        Value: arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:chatwoot/prod/secret_key_base
#   4. Give ECS Task Role permission: secretsmanager:GetSecretValue

# For local Docker only (not ECS):
#SECRET_KEY_BASE=your-64-char-secret-key-here

# ── Rails runtime ──────────────────────────────────────────────────────────
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
INSTALLATION_ENV=docker
FORCE_SSL=false

# ── Postgres (AWS RDS) ─────────────────────────────────────────────────────
# Use your RDS endpoint — NOT "postgres" (that is only for local Docker)
# Example: your-db-instance.xxxxxx.us-east-1.rds.amazonaws.com

POSTGRES_HOST=prod-chatwoot-rds.crcsqa2q0pn8.us-west-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=prod_chatwoot
POSTGRES_USERNAME=prod_admin
POSTGRES_USER=prod_admin
POSTGRES_PASSWORD=BYOYYMqbF6ojjMsP9y8LG

# ── Redis (AWS ElastiCache) ─────────────────────────────────────────────────
# Use your ElastiCache endpoint — NOT "redis" (that is only for local Docker)
# Example: your-cache.xxxxxx.cache.amazonaws.com
REDIS_URL=rediss://master.prod-chatwoot-redis.canv2o.usw2.cache.amazonaws.com:6379

# ── Mailer ─────────────────────────────────────────────────────────────────
MAILER_SENDER_EMAIL=your-email@yourdomain.com
SMTP_DOMAIN=yourdomain.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
# Store in AWS Secrets Manager
SMTP_PASSWORD=your-smtp-app-password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# ── File Storage (AWS S3) ───────────────────────────────────────────────────
# ECS containers are stateless — local storage is lost on restart.
# Use S3 for persistent file/attachment storage.
ACTIVE_STORAGE_SERVICE=amazon
S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ── Security toggles ───────────────────────────────────────────────────────
# Rack Attack — rate limiting for widget API (MUST be true in production)
# false = disabled (local dev only)
# true  = enabled  (production — protects against bots/floods)
ENABLE_RACK_ATTACK_WIDGET_API=true

# Allowed origins for widget embedding
WEB_WIDGET_ALLOWED_ORIGINS=https://yourwebsite.com

# ── Account Signup ─────────────────────────────────────────────────────────
# NOTE: This value is overridden automatically at startup.
# If a super admin already exists in the DB, signup is disabled regardless
# of this setting. Only set to true for the very first deployment.
ENABLE_ACCOUNT_SIGNUP=true

# ── Email Confirmation ─────────────────────────────────────────────────────
ENABLE_EMAIL_CONFIRMATION=false


